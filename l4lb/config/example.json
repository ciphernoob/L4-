{
  "listen": "0.0.0.0:9000",
  "admin_listen": "127.0.0.1:9001",
  "workers": 4,
  "algorithm": "round_robin",
  "backends": [
    {"id": "backend-1", "address": "127.0.0.1:9101", "weight": 1}
  ],
  "timeouts": {
    "connect_ms": 1000,
    "idle_ms": 60000
  },
  "buffer_watermarks": {
    "low_bytes": 65536,
    "high_bytes": 262144
  },
  "health_check": {
    "interval_ms": 5000,
    "timeout_ms": 1000,
    "failure_threshold": 3,
    "success_threshold": 2
  },
  "max_connect_retries": 2,
  "shutdown_grace_ms": 10000
}
